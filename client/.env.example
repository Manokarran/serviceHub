# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Product host (login, register, dashboard, builder).
# Local: http://localhost:3000
# Production: https://www.sidhiyana.com (or https://app.sidhiyana.com once you move the app there)
NEXT_PUBLIC_APP_URL=http://localhost:3000
BASEPATH=

# Multi-tenant subdomain routing (production). Leave empty for local path-based /site/{slug}.
# With this set, published sites are https://{slug}.sidhiyana.com
NEXT_PUBLIC_ROOT_DOMAIN=
# Subdomain that hosts the product (default: app). www/apex stay on the product until PLATFORM_SITE_SLUG is set.
NEXT_PUBLIC_APP_SUBDOMAIN=app
# Optional: when set, https://www.sidhiyana.com and https://sidhiyana.com serve this published tenant (marketing site).
# Leave empty while www still hosts the product.
NEXT_PUBLIC_PLATFORM_SITE_SLUG=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=serviceHub
MONGODB_DB_NAME=servicehub

# -----------------------------------------------------------------------------
# Auth (Google OAuth via NextAuth)
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=generate-a-long-random-secret
# Local dev only. On Vercel, do NOT set NEXTAUTH_URL — Auth.js uses the request host.
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Email notifications
# -----------------------------------------------------------------------------
EMAIL_FROM_NAME=
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_FROM=
SMTP_PASS=
ADMIN_EMAIL=
# Comma-separated emails that receive super admin access
SUPER_ADMIN=

# -----------------------------------------------------------------------------
# ImageKit (media uploads)
# -----------------------------------------------------------------------------
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# Tip: if your key ends with "=", wrap it in quotes, e.g. IMAGEKIT_PRIVATE_KEY="private_abc="

# -----------------------------------------------------------------------------
# Unsplash (background search)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_UNSPLASH_KEY=

# -----------------------------------------------------------------------------
# OpenAI (AI site wizard)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# Bulk copywriting — high volume, cheap model is fine
OPENAI_MODEL=gpt-4.1-mini
# Creative direction — small payload, benefits from the strongest model
OPENAI_DESIGN_MODEL=gpt-4.1
# Organization Admin API key for the super-admin usage panel
OPENAI_ADMIN_API_KEY=
OPENAI_ORGANIZATION_ID=
# Optional internal monthly ceiling used to estimate remaining budget
OPENAI_MONTHLY_BUDGET_USD=

# -----------------------------------------------------------------------------
# Cloudinary (Phase 2 — legacy placeholder)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Stripe (Phase 2)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
